# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas (or local)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/crop_recommendation?retryWrites=true&w=majority

# JWT (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ML Flask service (local or deployed)
ML_SERVICE_URL=http://localhost:5000

# CORS — comma-separated origins (your Vite dev + Vercel production URL)
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
